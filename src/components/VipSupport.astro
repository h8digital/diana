---
const items = [
	'Planejamento: Escolha do grupo ideal para o seu perfil.',
	'Estratégia: Definição de lances assertivos para acelerar sua conquista.',
	'Assessoria: Intermediação completa entre você e a administradora pós-contemplação.',
];
---

<section class="py-16 md:py-24">
	<div class="mx-auto max-w-3xl px-6 text-center">
		<h2 class="reveal text-2xl font-bold text-navy md:text-3xl">Acompanhamento VIP</h2>

		<ul class="mt-8 space-y-3 text-left">
			{items.map((item) => (
				<li class="reveal flex items-start gap-3 rounded-xl border border-navy/10 bg-white px-5 py-4 shadow-sm shadow-navy/5 transition-all hover:border-gold-deep/40 hover:shadow-md">
					<span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-navy/5 text-navy">
						<svg viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-current">
							<path d="M7.629 13.233 3.4 9.005l1.414-1.414 2.815 2.814L14.586 3.5 16 4.914z"/>
						</svg>
					</span>
					<span class="text-navy-soft">{item}</span>
				</li>
			))}
		</ul>
	</div>
</section>
