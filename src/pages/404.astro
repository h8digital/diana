---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logoMark from '../assets/images/logo-mark.png';
---

<BaseLayout title="Página não encontrada | Diana Dutra Investimentos">
	<main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
		<Image src={logoMark} alt="Diana Dutra" class="h-16 w-auto" width={140} height={144} />
		<p class="mt-3 text-sm font-bold text-navy">Diana Dutra Investimentos</p>
		<p class="text-xs font-medium text-navy-soft">Corretora Autorizada</p>
		<div class="mt-8 max-w-lg rounded-3xl border border-navy/10 bg-white p-10 shadow-xl shadow-navy/5">
			<p class="bg-gradient-to-br from-gold-deep to-gold bg-clip-text text-7xl font-extrabold text-transparent">404</p>
			<h1 class="mt-2 text-xl font-bold text-navy">Essa página não existe.</h1>
			<p class="mt-3 text-navy-soft">
				O link pode estar desatualizado ou a página foi movida. Volte para a página inicial para
				continuar navegando.
			</p>
			<a
				href="/"
				class="mt-6 inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-navy-light"
			>
				Voltar ao início
			</a>
		</div>
	</main>
</BaseLayout>
