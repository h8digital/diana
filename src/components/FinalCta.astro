---
import { Image } from 'astro:assets';
import logoMarkWhite from '../assets/images/logo-mark-white.png';
---

<section class="bg-navy py-16 text-center md:py-24">
	<div class="mx-auto max-w-2xl px-6">
		<h2 class="reveal text-2xl font-bold text-white md:text-3xl">Mude sua vida a partir de agora.</h2>
		<p class="reveal mt-4 text-white/75">
			Dê o primeiro passo rumo ao seu futuro ideal.<br />Ele começa aqui.
		</p>
		<a
			href="#formulario"
			class="reveal mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-gold to-gold-deep px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-navy shadow-lg shadow-black/20 transition-all hover:-translate-y-0.5 hover:shadow-xl"
		>
			Quero começar minha transformação agora!
		</a>

		<Image src={logoMarkWhite} alt="Diana Dutra" class="reveal mx-auto mt-12 h-14 w-auto" width={140} height={144} />
	</div>
</section>
