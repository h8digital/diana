---
import logoMark from '../assets/images/logo-mark.png';
import { Image } from 'astro:assets';
import { siteConfig } from '../lib/site-config';
---

<header class="sticky top-0 z-30 border-b border-navy/10 bg-paper/90 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-[22px]">
		<a href="#inicio" class="flex items-center gap-3">
			<Image src={logoMark} alt="Diana Dutra" class="h-9 w-auto" width={140} height={144} />
			<div class="hidden leading-tight sm:block">
				<p class="text-sm font-bold text-navy">Diana Dutra Investimentos</p>
				<p class="text-[11px] font-medium text-navy-soft">Corretora Autorizada</p>
			</div>
		</a>

		<nav class="hidden items-center gap-7 md:flex">
			{siteConfig.nav.map((item) => (
				<a href={item.href} class="text-sm font-medium text-navy/80 transition-colors hover:text-navy">
					{item.label}
				</a>
			))}
		</nav>

		<a
			href="#formulario"
			class="rounded-full bg-gradient-to-br from-gold-deep to-gold px-7 py-3 text-sm font-bold text-navy shadow-md shadow-gold-deep/30 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gold-deep/40"
		>
			Simular agora
		</a>
	</div>
</header>
