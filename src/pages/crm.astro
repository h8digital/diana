---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logoMark from '../assets/images/logo-mark.png';
---

<BaseLayout title="CRM | Diana Dutra Investimentos" showWhatsApp={false} enableTracking={false}>
	<div class="min-h-screen bg-mist">
		<header class="flex items-center justify-between border-b border-navy/10 bg-white px-6 py-3">
			<div class="flex items-center gap-3">
				<Image src={logoMark} alt="Diana Dutra" class="h-8 w-auto" width={140} height={144} />
				<span class="text-sm font-bold text-navy">CRM</span>
			</div>
			<div class="flex items-center gap-4">
				<a href="/crm/manual" class="text-sm font-semibold text-navy-soft transition-colors hover:text-navy">
					📘 Manual
				</a>
				<div id="crm-user-bar" class="hidden items-center gap-4">
					<button id="crm-settings-open" class="text-sm font-semibold text-navy-soft transition-colors hover:text-navy">
						⚙ Configurações
					</button>
					<span id="crm-username" class="text-sm text-navy-soft"></span>
					<button id="crm-logout" class="rounded-full border border-navy/20 px-4 py-1.5 text-xs font-semibold text-navy transition-colors hover:bg-navy hover:text-white">
						Sair
					</button>
				</div>
			</div>
		</header>

		<!-- Login -->
		<div id="crm-login-view" class="flex min-h-[calc(100vh-57px)] items-center justify-center px-6">
			<form id="crm-login-form" class="w-full max-w-sm rounded-2xl border border-navy/10 bg-white p-8 shadow-lg shadow-navy/5">
				<h1 class="text-center text-xl font-bold text-navy">Acesso ao CRM</h1>
				<p class="mt-1 text-center text-sm text-navy-soft">Entre com suas credenciais</p>

				<div class="mt-6 space-y-3">
					<input
						id="crm-username-input"
						name="username"
						type="text"
						autocomplete="username"
						required
						placeholder="Usuário"
						class="w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-3 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
					/>
					<input
						id="crm-password-input"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						placeholder="Senha"
						class="w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-3 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
					/>
				</div>

				<button
					type="submit"
					class="mt-5 w-full rounded-xl bg-navy px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-navy-light"
				>
					Entrar
				</button>
				<p id="crm-login-error" class="mt-3 hidden text-center text-sm font-medium text-red-600"></p>
			</form>
		</div>

		<!-- Board -->
		<div id="crm-board-view" class="hidden">
			<div class="flex items-center justify-between px-6 pt-6">
				<h1 class="text-lg font-bold text-navy">Leads</h1>
				<button id="crm-add-stage" class="rounded-full bg-gold px-4 py-2 text-xs font-bold uppercase tracking-wide text-navy transition-all hover:bg-gold-deep">
					+ Nova etapa
				</button>
			</div>
			<div id="crm-board" class="flex items-start gap-4 overflow-x-auto px-6 py-6"></div>
		</div>
	</div>

	<!-- Lead detail modal -->
	<div id="crm-lead-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/40 px-4">
		<div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
			<div class="flex items-start justify-between">
				<h2 id="crm-modal-name" class="text-lg font-bold text-navy"></h2>
				<button id="crm-modal-close" class="text-navy-soft hover:text-navy">✕</button>
			</div>
			<p id="crm-modal-phone" class="mt-1 text-sm text-navy-soft"></p>
			<p id="crm-modal-meta" class="mt-1 text-xs text-navy-soft"></p>
			<a id="crm-modal-whatsapp" target="_blank" rel="noopener" class="mt-3 inline-block rounded-full bg-[#25d366] px-4 py-2 text-xs font-semibold text-white">
				Abrir WhatsApp
			</a>

			<label for="crm-modal-value" class="mt-4 block text-xs font-semibold uppercase tracking-wide text-navy-soft">Valor do crédito em negociação</label>
			<div class="mt-1 flex items-center rounded-xl border border-navy/15 bg-mist/60 px-3 focus-within:border-gold-deep focus-within:bg-white focus-within:ring-4 focus-within:ring-gold/25">
				<span class="text-sm text-navy-soft">R$</span>
				<input
					id="crm-modal-value"
					type="text"
					inputmode="numeric"
					placeholder="0,00"
					class="w-full bg-transparent px-2 py-2 text-sm text-navy outline-none"
				/>
			</div>

			<label for="crm-modal-notes" class="mt-4 block text-xs font-semibold uppercase tracking-wide text-navy-soft">Notas</label>
			<textarea
				id="crm-modal-notes"
				rows="4"
				class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-3 py-2 text-sm text-navy outline-none focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
			></textarea>
			<div class="mt-4 flex justify-between">
				<button id="crm-modal-delete" class="text-xs font-semibold text-red-600 hover:underline">Excluir lead</button>
				<button id="crm-modal-save" class="rounded-full bg-navy px-5 py-2 text-xs font-semibold text-white hover:bg-navy-light">Salvar</button>
			</div>
		</div>
	</div>

	<!-- Settings modal -->
	<div id="crm-settings-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/40 px-4 py-8">
		<div class="max-h-full w-full max-w-md overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
			<div class="flex items-start justify-between">
				<h2 class="text-lg font-bold text-navy">Notificação de novos leads</h2>
				<button id="crm-settings-close" class="text-navy-soft hover:text-navy">✕</button>
			</div>
			<p class="mt-1 text-sm text-navy-soft">Envia um e-mail por SMTP sempre que um lead se cadastra pelo site.</p>

			<label class="mt-5 flex items-center gap-3">
				<input id="crm-settings-enabled" type="checkbox" class="h-4 w-4 rounded border-navy/30 accent-gold-deep" />
				<span class="text-sm font-semibold text-navy">Enviar e-mail a cada novo lead</span>
			</label>

			<label for="crm-settings-to" class="mt-4 block text-xs font-semibold uppercase tracking-wide text-navy-soft">
				E-mail(s) de destino
			</label>
			<input
				id="crm-settings-to"
				type="text"
				autocomplete="off"
				placeholder="contato@exemplo.com.br"
				class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-3 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
			/>
			<p class="mt-1 text-[11px] text-navy-soft/70">Separe vários endereços por vírgula.</p>

			<div class="mt-5 border-t border-navy/10 pt-4">
				<h3 class="text-xs font-semibold uppercase tracking-wide text-navy-soft">Servidor de envio (SMTP)</h3>

				<label for="crm-smtp-host" class="mt-3 block text-xs font-semibold text-navy">Servidor SMTP</label>
				<input id="crm-smtp-host" type="text" autocomplete="off" placeholder="smtp.seuprovedor.com.br"
					class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25" />

				<div class="mt-3 grid grid-cols-2 gap-3">
					<div>
						<label for="crm-smtp-port" class="block text-xs font-semibold text-navy">Porta</label>
						<input id="crm-smtp-port" type="text" inputmode="numeric" placeholder="587"
							class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25" />
					</div>
					<div>
						<label for="crm-smtp-secure" class="block text-xs font-semibold text-navy">Segurança</label>
						<select id="crm-smtp-secure"
							class="mt-1 w-full appearance-none rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25">
							<option value="starttls">STARTTLS (porta 587)</option>
							<option value="ssl">SSL/TLS (porta 465)</option>
						</select>
					</div>
				</div>

				<label for="crm-smtp-user" class="mt-3 block text-xs font-semibold text-navy">Usuário</label>
				<input id="crm-smtp-user" type="text" autocomplete="off" placeholder="usuario@seudominio.com.br"
					class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25" />

				<label for="crm-smtp-pass" class="mt-3 block text-xs font-semibold text-navy">Senha</label>
				<input id="crm-smtp-pass" type="password" autocomplete="new-password" placeholder="••••••••"
					class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25" />
				<p id="crm-smtp-pass-hint" class="mt-1 hidden text-[11px] text-navy-soft/70">Já existe uma senha salva. Deixe em branco para mantê-la.</p>

				<label for="crm-smtp-from" class="mt-3 block text-xs font-semibold text-navy">Remetente (De:)</label>
				<input id="crm-smtp-from" type="text" autocomplete="off" placeholder="Diana Dutra Investimentos &lt;contato@seudominio.com.br&gt;"
					class="mt-1 w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-2.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25" />
				<p class="mt-1 text-[11px] text-navy-soft/70">Formato: <code class="font-mono">Nome &lt;email@dominio&gt;</code> ou só o e-mail.</p>
			</div>

			<p id="crm-settings-warning" class="mt-3 hidden rounded-lg bg-amber-50 px-3 py-2 text-xs font-medium text-amber-700"></p>
			<p id="crm-settings-status" class="mt-3 hidden text-sm font-medium"></p>
			<pre id="crm-settings-diag" class="mt-2 hidden max-h-44 overflow-auto whitespace-pre-wrap rounded-lg bg-navy/5 p-3 text-[11px] leading-relaxed text-navy-soft"></pre>

			<div class="mt-5 flex items-center justify-between gap-3">
				<button id="crm-settings-test" class="rounded-full border border-navy/20 px-4 py-2 text-xs font-semibold text-navy transition-colors hover:bg-navy hover:text-white">
					Enviar e-mail de teste
				</button>
				<button id="crm-settings-save" class="rounded-full bg-navy px-5 py-2 text-xs font-semibold text-white hover:bg-navy-light">
					Salvar
				</button>
			</div>
		</div>
	</div>

	<script src="../scripts/crm.ts"></script>
</BaseLayout>
