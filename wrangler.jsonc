{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "diana-dutra-investimentos",
	"main": "worker.js",
	"compatibility_date": "2025-06-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// O Worker roda antes dos assets para poder injetar as tags de
		// rastreamento no HTML (worker.js `injectTracking`). Requisições que não
		// são de API caem em `env.ASSETS.fetch` e seguem normalmente.
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "diana-crm",
			"database_id": "dc8ec433-ea6e-4986-b982-32eb0a227cee"
		}
	]
}
