---
import { COUNTRIES, DEFAULT_COUNTRY_ISO } from '../scripts/countries';
---

<section id="formulario" class="relative bg-mist py-16 md:py-20">
	<div class="reveal mx-auto max-w-2xl px-6">
		<div class="rounded-3xl border border-navy/10 bg-white p-8 shadow-xl shadow-navy/5 md:p-10">
			<h2 class="text-center text-2xl font-bold text-navy md:text-3xl">Peça sua simulação gratuita</h2>
			<p class="mt-2 text-center text-navy-soft">Em poucos minutos você entende como transformar crédito em patrimônio.</p>

			<form id="lead-form" class="mt-8 space-y-4" novalidate>
				<div>
					<label for="lead-name" class="sr-only">Nome</label>
					<input
						id="lead-name"
						name="name"
						type="text"
						required
						autocomplete="name"
						placeholder="Digite seu nome"
						class="w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-3.5 text-navy placeholder:text-navy-soft/70 outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
					/>
				</div>
				<div>
					<label for="lead-email" class="sr-only">E-mail</label>
					<input
						id="lead-email"
						name="email"
						type="email"
						required
						autocomplete="email"
						placeholder="Digite seu e-mail"
						class="w-full rounded-xl border border-navy/15 bg-mist/60 px-4 py-3.5 text-navy placeholder:text-navy-soft/70 outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
					/>
					<p data-field-error="email" class="mt-1.5 hidden px-1 text-xs font-medium text-red-600"></p>
				</div>
				<div>
					<label for="lead-phone" class="sr-only">WhatsApp</label>
					<div class="flex gap-2">
						<label for="lead-country" class="sr-only">País</label>
						<select
							id="lead-country"
							name="country"
							required
							class="w-[100px] shrink-0 appearance-none rounded-xl border border-navy/15 bg-mist/60 px-2 py-3.5 text-center text-sm text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
						>
							{COUNTRIES.map((country) => (
								<option value={country.iso} selected={country.iso === DEFAULT_COUNTRY_ISO}>
									{country.flag} +{country.dial}
								</option>
							))}
						</select>
						<input
							id="lead-phone"
							name="phone"
							type="tel"
							inputmode="numeric"
							required
							autocomplete="tel-national"
							placeholder="(51) 99918-1068"
							class="w-full min-w-0 flex-1 rounded-xl border border-navy/15 bg-mist/60 px-4 py-3.5 text-navy placeholder:text-navy-soft/70 outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
						/>
					</div>
					<p data-field-error="phone" class="mt-1.5 hidden px-1 text-xs font-medium text-red-600"></p>
				</div>
				<div>
					<label for="lead-objective" class="sr-only">Seu objetivo</label>
					<select
						id="lead-objective"
						name="objective"
						required
						class="w-full appearance-none rounded-xl border border-navy/15 bg-mist/60 px-4 py-3.5 text-navy outline-none transition-all focus:border-gold-deep focus:bg-white focus:ring-4 focus:ring-gold/25"
					>
						<option value="" disabled selected>Selecione seu objetivo</option>
						<option value="Imóvel">Imóvel</option>
						<option value="Veículo">Veículo</option>
						<option value="Investimento">Investimento</option>
					</select>
				</div>

				<button
					type="submit"
					class="group relative w-full overflow-hidden rounded-xl bg-gradient-to-r from-gold to-gold-deep px-6 py-4 text-sm font-bold uppercase tracking-wide text-navy shadow-lg shadow-gold/30 transition-all hover:-translate-y-0.5 hover:shadow-xl"
				>
					<span class="relative">Quero transformar meu patrimônio agora!</span>
				</button>

				<p data-form-status role="status" class="hidden text-center text-sm font-medium"></p>
			</form>
		</div>
	</div>
</section>

<script>
	import { fireLeadTracking, getCookie, uuid } from '../scripts/tracking';
	import { attachPhoneMask } from '../scripts/phone-mask';
	import { COUNTRIES, DEFAULT_COUNTRY_ISO } from '../scripts/countries';
	import { validateEmail, validatePhoneDigits } from '../scripts/lead-validation';

	const ERROR_CLASSES = ['border-red-400', 'focus:border-red-500', 'focus:ring-red-200'];
	const NORMAL_CLASSES = ['border-navy/15', 'focus:border-gold-deep', 'focus:ring-gold/25'];

	function initLeadForm(): void {
		const form = document.querySelector<HTMLFormElement>('#lead-form');
		const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');
		if (!form || !status) return;

		const countrySelect = form.querySelector<HTMLSelectElement>('#lead-country');
		const phoneInput = form.querySelector<HTMLInputElement>('#lead-phone');
		const emailInput = form.querySelector<HTMLInputElement>('#lead-email');
		if (!countrySelect || !phoneInput || !emailInput) return;

		const isBrazil = () => countrySelect.value === DEFAULT_COUNTRY_ISO;
		const currentDial = () => COUNTRIES.find((c) => c.iso === countrySelect.value)?.dial ?? '55';

		attachPhoneMask(phoneInput, isBrazil);

		function showFieldError(input: HTMLInputElement, message: string | null): void {
			const errorEl = form?.querySelector<HTMLParagraphElement>(`[data-field-error="${input.name}"]`);
			if (message) {
				input.classList.remove(...NORMAL_CLASSES);
				input.classList.add(...ERROR_CLASSES);
				if (errorEl) {
					errorEl.textContent = message;
					errorEl.classList.remove('hidden');
				}
			} else {
				input.classList.remove(...ERROR_CLASSES);
				input.classList.add(...NORMAL_CLASSES);
				if (errorEl) {
					errorEl.textContent = '';
					errorEl.classList.add('hidden');
				}
			}
		}

		const validatePhoneField = (): boolean => {
			const digits = phoneInput.value.replace(/\D/g, '');
			const message = validatePhoneDigits(digits, isBrazil());
			phoneInput.setCustomValidity(message ?? '');
			showFieldError(phoneInput, message);
			return !message;
		};

		const validateEmailField = (): boolean => {
			const message = validateEmail(emailInput.value.trim());
			emailInput.setCustomValidity(message ?? '');
			showFieldError(emailInput, message);
			return !message;
		};

		countrySelect.addEventListener('change', () => {
			phoneInput.value = '';
			validatePhoneField();
			phoneInput.focus();
		});
		phoneInput.addEventListener('input', validatePhoneField);
		phoneInput.addEventListener('blur', validatePhoneField);
		emailInput.addEventListener('input', validateEmailField);
		emailInput.addEventListener('blur', validateEmailField);

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const phoneValid = validatePhoneField();
			const emailValid = validateEmailField();
			if (!phoneValid || !emailValid || !form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			submitButton?.setAttribute('disabled', 'true');
			status.classList.remove('hidden', 'text-red-600', 'text-emerald-600');
			status.textContent = 'Enviando...';

			const eventId = uuid();
			const formData = new FormData(form);
			const name = String(formData.get('name') ?? '');
			const email = String(formData.get('email') ?? '').trim();
			const phone = `+${currentDial()}${phoneInput.value.replace(/\D/g, '')}`;
			const objective = String(formData.get('objective') ?? '');

			fireLeadTracking(eventId, objective);

			try {
				const response = await fetch('/api/lead', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						eventId,
						name,
						email,
						phone,
						objective,
						fbp: getCookie('_fbp'),
						fbc: getCookie('_fbc'),
						pageUrl: window.location.href,
					}),
				});

				if (!response.ok) throw new Error('request_failed');

				status.textContent = 'Recebemos seus dados! Em breve a Diana entra em contato.';
				status.classList.add('text-emerald-600');
				form.reset();
			} catch {
				status.textContent = 'Não foi possível enviar agora. Tente novamente ou fale direto pelo WhatsApp.';
				status.classList.add('text-red-600');
			} finally {
				submitButton?.removeAttribute('disabled');
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initLeadForm);
	} else {
		initLeadForm();
	}
</script>
